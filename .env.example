# Copy this file to .env and fill in ONE key. Never commit .env.
#   cp .env.example .env

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# "google" or "groq". Leave empty to pick google when GEMINI_API_KEY is set.
MODEL_PROVIDER=
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-20b

HOST=127.0.0.1
PORT=8000
# Seconds to wait for all three agents before returning HTTP 504
REQUEST_TIMEOUT=90
